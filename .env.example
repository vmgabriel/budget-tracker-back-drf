# Copy this file to .env with `make install`.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=budget-tracker

# Django
DJANGO_ENVIRONMENT=local
# Keep this secret stable across replicas; it also signs JWTs.
DJANGO_SECRET_KEY=unsafe-development-only-change-me-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO
# Enable only for local SQL debugging; keep disabled in production.
DJANGO_LOG_QUERIES=false
DJANGO_TIME_ZONE=UTC
DJANGO_DATABASE_CONN_MAX_AGE=60
DJANGO_SECURE_SSL_REDIRECT=false
# Session/CSRF settings below are retained for Django's non-API surfaces.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_SESSION_COOKIE_AGE=1209600
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# PostgreSQL credentials. URL-encode special characters in password URLs.
POSTGRES_DB=budget_tracker
POSTGRES_USER=budget_tracker
POSTGRES_PASSWORD=budget_tracker
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# URLs used by Hatch/commands running directly on the host.
DATABASE_URL=postgresql://budget_tracker:budget_tracker@localhost:5432/budget_tracker
TEST_DATABASE_URL=postgresql://budget_tracker:budget_tracker@localhost:5432/test_budget_tracker

# URLs used by services running inside Docker Compose.
DOCKER_DATABASE_URL=postgresql://budget_tracker:budget_tracker@db:5432/budget_tracker
DOCKER_TEST_DATABASE_URL=postgresql://budget_tracker:budget_tracker@db:5432/test_budget_tracker

# Redis
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
DOCKER_CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_LOG_LEVEL=INFO
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Local Ollama daemon used for task assistance (evaluation, decomposition,
# daily plans). Task content stays on this machine; point OLLAMA_BASE_URL at
# another host to use a different daemon.
#
# Two variables, because the right answer depends on who is asking:
#   - OLLAMA_BASE_URL is used by Hatch and anything running on the host, where
#     a daemon on this machine is "localhost".
#   - DOCKER_OLLAMA_BASE_URL is used by the containers. "localhost" inside a
#     container is the container itself, so a host-local daemon must be reached
#     as "host.docker.internal" (see the extra_hosts entry in docker-compose).
# If your daemon runs on another machine on the LAN, put that address in both.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# When Celery Beat queues each user's daily plan. Standard five-field cron
# ("minute hour day month weekday"); only the hour and minute may vary, because
# the job plans one day at a time. An unparseable value falls back to 06:00 with
# a warning rather than stopping the worker from booting.
DAILY_PLAN_GENERATION_CRON=0 6 * * *

# HTTP server
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
GUNICORN_WORKERS=3
