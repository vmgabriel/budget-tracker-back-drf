# Copy this file to .env with `make install`.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=budget-tracker

# Django
DJANGO_ENVIRONMENT=local
# Keep this secret stable across replicas; it also signs JWTs.
DJANGO_SECRET_KEY=unsafe-development-only-change-me-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO
# Enable only for local SQL debugging; keep disabled in production.
DJANGO_LOG_QUERIES=false
DJANGO_TIME_ZONE=UTC
DJANGO_DATABASE_CONN_MAX_AGE=60
DJANGO_SECURE_SSL_REDIRECT=false
# Session/CSRF settings below are retained for Django's non-API surfaces.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_SESSION_COOKIE_AGE=1209600
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# --- Production security -----------------------------------------------------
# Production settings refuse to start on a development secret, an empty or
# wildcard host list, DEBUG=true, an HTTP CSRF origin, insecure cookies, or an
# HTTP CORS origin, so set these before deploying. Every value has a
# production-shaped default; override only where the deployment differs.
#
# DJANGO_SECRET_KEY must be replaced (see scripts/generate_secret_key.sh):
#   DJANGO_SECRET_KEY=<at least 50 random characters>
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_SESSION_COOKIE_SAMESITE=Lax
# DJANGO_CSRF_COOKIE_SAMESITE=Lax
# DJANGO_REFERRER_POLICY=strict-origin-when-cross-origin
# DJANGO_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
# DJANGO_X_FRAME_OPTIONS=DENY

# Number of trusted reverse proxies between the client and the app. Caddy in
# front of the container counts as one. DRF needs it to recover the real client
# address for rate limiting; leave it at 0 only when nothing proxies the API.
# DJANGO_NUM_PROXIES=1

# Cross-origin allowlist for the browser front end (house-utility-control-front).
# Exact origins, HTTPS only, no trailing slash, no wildcard. Credentials stay
# disabled: the front end authenticates with a JWT bearer token, not cookies.
# CORS_ALLOWED_ORIGINS=https://bff.yourdomain.com

# Rate limits. The defaults suit an interactive front end; raise them only with
# a reason (a shared office NAT is the usual one).
# THROTTLE_ANON_RATE=100/hour
# THROTTLE_USER_RATE=1000/hour
# THROTTLE_LOGIN_RATE=10/minute
# THROTTLE_REGISTER_RATE=5/hour

# Database timeouts. The statement timeout applies everywhere and bounds a
# runaway query; the connect timeout defaults to 5s in production only, and 0
# here means "leave it to the driver".
# DJANGO_STATEMENT_TIMEOUT_MS=30000
# DJANGO_CONNECT_TIMEOUT=0

# Email. Nothing sends mail yet (no password-reset flow); these exist so adding
# one does not mean re-deriving the configuration.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=<user>
# EMAIL_HOST_PASSWORD=<pass>
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# PostgreSQL credentials. URL-encode special characters in password URLs.
POSTGRES_DB=budget_tracker
POSTGRES_USER=budget_tracker
POSTGRES_PASSWORD=budget_tracker
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# URLs used by Hatch/commands running directly on the host.
DATABASE_URL=postgresql://budget_tracker:budget_tracker@localhost:5432/budget_tracker
TEST_DATABASE_URL=postgresql://budget_tracker:budget_tracker@localhost:5432/test_budget_tracker

# URLs used by services running inside Docker Compose.
DOCKER_DATABASE_URL=postgresql://budget_tracker:budget_tracker@db:5432/budget_tracker
DOCKER_TEST_DATABASE_URL=postgresql://budget_tracker:budget_tracker@db:5432/test_budget_tracker

# Redis
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
DOCKER_CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_LOG_LEVEL=INFO
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Local Ollama daemon used for task assistance (evaluation, decomposition,
# daily plans). Task content stays on this machine; point OLLAMA_BASE_URL at
# another host to use a different daemon.
#
# Two variables, because the right answer depends on who is asking:
#   - OLLAMA_BASE_URL is used by Hatch and anything running on the host, where
#     a daemon on this machine is "localhost".
#   - DOCKER_OLLAMA_BASE_URL is used by the containers. "localhost" inside a
#     container is the container itself, so a host-local daemon must be reached
#     as "host.docker.internal" (see the extra_hosts entry in docker-compose).
# If your daemon runs on another machine on the LAN, put that address in both.
# LAN daemon (reference deployment: the Ollama host at 192.168.2.10):
#   OLLAMA_BASE_URL=http://192.168.2.10:11434
#   DOCKER_OLLAMA_BASE_URL=http://192.168.2.10:11434
# Local daemon (default):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# When Celery Beat queues each user's daily plan. Standard five-field cron
# ("minute hour day month weekday"); only the hour and minute may vary, because
# the job plans one day at a time. An unparseable value falls back to 06:00 with
# a warning rather than stopping the worker from booting.
DAILY_PLAN_GENERATION_CRON=0 6 * * *

# HTTP server
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# Worker count. The development Compose file falls back to 3; production leaves
# this unset so gunicorn.conf.py derives (2 * visible CPUs) + 1. Set it
# explicitly only to cap workers on a shared host: every worker and thread
# opens its own PostgreSQL connection.
# GUNICORN_WORKERS=6
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# GUNICORN_LOG_LEVEL=info

# Static and media files. Defaults match the local layout; the production
# Compose stack overrides both to the named volumes it mounts.
DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=
# How long WhiteNoise may cache hashed static files, in seconds.
DJANGO_STATIC_MAX_AGE=31536000

# Production resource ceilings (docker-compose.prod.yml only). Lower these on
# a small VPS; keep workers * threads under PostgreSQL max_connections.
WEB_CPUS_LIMIT=2
WEB_MEMORY_LIMIT=1g
WORKER_CPUS_LIMIT=2
WORKER_MEMORY_LIMIT=2g
CELERY_CONCURRENCY=2
# Data services.
DATA_CPUS_LIMIT=2
DATA_MEMORY_LIMIT=2g
DB_MAX_CONNECTIONS=100
REDIS_MAXMEMORY=256mb
# noeviction keeps queued Celery tasks from being dropped when Redis fills.
REDIS_MAXMEMORY_POLICY=noeviction

# Database backups (scripts/backup_db.sh). Retention is in days.
BACKUP_DIR=/backups
RETENTION_DAYS=7
